# Producer LOG_TAG forwarding settings by Contents Name.
# Set producer to true to copy the Interest LOG_TAG into the Data packet.
# A name matches exactly (case-sensitive, chunk number ignored).
# A name ending with "/*" matches every name under that prefix, at any depth
# (e.g. "ccnx:/test.com/docs/*" matches ccnx:/test.com/docs/a and ccnx:/test.com/docs/a/b)
contents:
  - name: "ccnx:/example/content"
    producer: false
